{
  "name": "acedcombat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ACED COMBAT - arcade jet combat for the phone browser (three.js, Blender-rendered assets, tilt controls)",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=esm --target=safari15 --outfile=dist/game.js",
    "dev": "esbuild src/main.js --bundle --format=esm --target=safari15 --outfile=dist/game.js --watch",
    "serve": "node tools/serve.mjs 8080"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "puppeteer-core": "^23.11.1"
  }
}
